APP_KEY=

# Locale: the app is Hebrew-first. Dates and date-times are presented day-first
# in the Asia/Jerusalem UI timezone.
APP_LOCALE=he
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=he_IL

# Mail: local default writes messages to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@podtext.co.il
MAIL_FROM_NAME="${APP_NAME}"

# Mail option A, recommended for production: Resend API transport.
# Set MAIL_MAILER=resend and RESEND_API_KEY after verifying the sending domain.
RESEND_API_KEY=

# Inbound Resend webhook verification. This signing secret is separate from the API key.
RESEND_WEBHOOK_SECRET=

# Mail option B, zero-package/provider-generic SMTP fallback.
# Resend SMTP: MAIL_HOST=smtp.resend.com, MAIL_USERNAME=resend, MAIL_PASSWORD=API key.
# Brevo SMTP: use Brevo's SMTP host, login, and SMTP key from the account console.
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=

# Public forms email OTP policy.
FORMS_OTP_EXPIRES_MINUTES=5
FORMS_OTP_MAX_ATTEMPTS=5
FORMS_OTP_RESEND_COOLDOWN_SECONDS=60

# Optional. If unset, Curator Glide falls back to APP_KEY for signed media URLs.
CURATOR_GLIDE_TOKEN=

# Optional. Leave disabled locally; enable in production when persistent Spatie settings caching is desired.
SETTINGS_CACHE_ENABLED=false
SETTINGS_CACHE_MEMO=false

# Media picker driver behind the app-owned picker field. Only 'curator' is implemented.
PODTEXT_MEDIA_PICKER_DRIVER=curator

# Settings backups: how many backups to keep, and the timeouts for the queued
# snapshot job and the Playwright snapshot process it runs.
SETTINGS_BACKUPS_RETENTION=25
SETTINGS_BACKUP_SNAPSHOT_JOB_TIMEOUT=1800
SETTINGS_BACKUP_SNAPSHOT_PROCESS_TIMEOUT=120

# Importer: Google OAuth for Drive/Docs connections, plus a per-request throttle
# in milliseconds (0 disables it) and the import/export log channel level.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
IMPORTER_GOOGLE_THROTTLE_MS=0
IMPORT_EXPORT_LOG_LEVEL=debug

# Horizon: dashboard path and the supervisor timeout, which must stay above the
# longest queued job (imports and settings snapshots are the long ones).
HORIZON_PATH=horizon
HORIZON_SUPERVISOR_TIMEOUT=1850
