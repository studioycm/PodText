# =============================================================================
# PodText — environment template
#
# Copy to .env and fill the values marked REQUIRED. Every var below is read by
# something in config/; anything omitted falls back to the config default, which
# is NOT always what you want (see the warnings).
#
# Generate the key after copying:  php artisan key:generate
# =============================================================================

# --- Application -------------------------------------------------------------
# APP_NAME is not cosmetic: it seeds CACHE_PREFIX, REDIS_PREFIX, SESSION_COOKIE
# and HORIZON_PREFIX. Two apps sharing one Redis with the same APP_NAME collide.
APP_NAME=PodText
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Note: config/app.php hardcodes the app timezone to UTC. Asia/Jerusalem is
# applied at the presentation layer, so APP_TIMEZONE here would be a no-op.

# Locale: the app is Hebrew-first. Dates and date-times are presented day-first
# in the Asia/Jerusalem UI timezone.
APP_LOCALE=he
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=he_IL

# --- Database (REQUIRED) -----------------------------------------------------
# With DB_CONNECTION unset the app falls back to the `mysql` connection's own
# defaults: root@127.0.0.1:3306, schema `laravel`, empty password. On this
# machine that daemon ACCEPTS root/blank — the fallback fails only while no
# schema named `laravel` exists there, and connects SILENTLY to it the day one
# does (any stock `laravel new` creates it). Set the DB_* block explicitly;
# never rely on the fallback.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=podtext
DB_USERNAME=podtext
DB_PASSWORD=

# MySQL test lane: the suite runs against a DEDICATED 8.0.46 daemon (port 3307),
# never the app daemon above — the lane user's grant is schema-scoped to the
# lane database only. All four keys must be set for tests to run; the guard
# in tests/TestCase.php fails closed when the database name is missing.
DB_TESTING_HOST=
DB_TESTING_PORT=
DB_TESTING_DATABASE=
DB_TESTING_USERNAME=
DB_TESTING_PASSWORD=

# --- Cache / queue / session -------------------------------------------------
# Queue and cache both run on Redis in production; Horizon requires Redis.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# COUPLING: REDIS_QUEUE_RETRY_AFTER must stay ABOVE HORIZON_SUPERVISOR_TIMEOUT
# (below), or long jobs are released back onto the queue while still running
# and execute twice.
REDIS_QUEUE_RETRY_AFTER=1900

BROADCAST_CONNECTION=log

# --- Filesystem --------------------------------------------------------------
# Curator media lives on the "public" disk; run `php artisan storage:link`.
FILESYSTEM_DISK=local

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Mail --------------------------------------------------------------------
# Local default writes messages to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@podtext.co.il
MAIL_FROM_NAME="${APP_NAME}"

# Mail option A, recommended for production: Resend API transport.
# Set MAIL_MAILER=resend and RESEND_API_KEY after verifying the sending domain.
RESEND_API_KEY=

# Inbound Resend webhook verification. This signing secret is separate from the
# API key. The webhook middleware FAILS CLOSED — a blank value silently rejects
# every inbound event.
RESEND_WEBHOOK_SECRET=

# Mail option B, zero-package/provider-generic SMTP fallback.
# Resend SMTP: MAIL_HOST=smtp.resend.com, MAIL_USERNAME=resend, MAIL_PASSWORD=API key.
# Brevo SMTP: use Brevo's SMTP host, login, and SMTP key from the account console.
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# Laravel 11+ reads MAIL_SCHEME (smtp|smtps). The old MAIL_ENCRYPTION is dead —
# no config reads it.
MAIL_SCHEME=null

# --- Public forms ------------------------------------------------------------
FORMS_OTP_EXPIRES_MINUTES=5
FORMS_OTP_MAX_ATTEMPTS=5
FORMS_OTP_RESEND_COOLDOWN_SECONDS=60

# --- Media / Curator ---------------------------------------------------------
# Signed-URL token for Curator's Glide image pipeline.
# WARNING: keep this line COMMENTED OUT to get the documented APP_KEY fallback.
# An empty value is NOT the same as unset — config/curator.php uses the empty
# string verbatim, so media URLs end up signed with an empty token.
# Either leave it commented, or set a real value: openssl rand -hex 32
# CURATOR_GLIDE_TOKEN=

# Media picker driver behind the app-owned picker field. Only 'curator' is implemented.
PODTEXT_MEDIA_PICKER_DRIVER=curator

# --- Settings ----------------------------------------------------------------
# Leave disabled locally; enable in production when persistent Spatie settings
# caching is desired.
SETTINGS_CACHE_ENABLED=false
SETTINGS_CACHE_MEMO=false

# Settings backups: how many backups to keep, and the timeouts for the queued
# snapshot job and the Playwright snapshot process it runs.
SETTINGS_BACKUPS_RETENTION=25
SETTINGS_BACKUP_SNAPSHOT_JOB_TIMEOUT=1800
SETTINGS_BACKUP_SNAPSHOT_PROCESS_TIMEOUT=120

# --- Importer ----------------------------------------------------------------
# Google OAuth for Drive/Docs connections, plus a per-request throttle in
# milliseconds (0 disables it) and the import/export log channel level.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
IMPORTER_GOOGLE_THROTTLE_MS=0
IMPORT_EXPORT_LOG_LEVEL=debug

# --- Horizon -----------------------------------------------------------------
# Dashboard path, and the supervisor timeout which must stay above the longest
# queued job (imports and settings snapshots are the long ones) and BELOW
# REDIS_QUEUE_RETRY_AFTER above.
HORIZON_PATH=horizon
HORIZON_SUPERVISOR_TIMEOUT=1850

# --- Frontend build ----------------------------------------------------------
# Anything prefixed VITE_ is compiled into the public JavaScript bundle and is
# readable by every visitor. NEVER put APP_KEY, a secret, or any credential here.
VITE_APP_NAME="${APP_NAME}"

# --- Media quarantine retention ---------------------------------------------
# Completed media-mutation quarantine copies older than this many days can be
# pruned by `php artisan media:prune-quarantine --apply` (dry-run without
# --apply). 0 keeps quarantine copies forever. Incomplete operations are never
# pruned. The scheduled daily prune fires only if the host runs `schedule:run`.
MEDIA_QUARANTINE_RETENTION_DAYS=90
