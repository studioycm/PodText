#!/bin/sh

# Thin launcher. git requires this exact filename, and an extensionless file is
# invisible to Pint (which scans *.php) and to any future static analysis, so
# the logic lives in the .php beside it and this file only finds an interpreter.
#
# No external binaries are used — not even dirname — because the one branch this
# launcher exists to handle is a caller with a minimal PATH.
#
# php missing is FAIL-OPEN and loud: a guard whose interpreter is absent must
# not make every commit on that machine impossible. See the .php for what the
# guard does and why (pestphp/pest#1856, T23b).

dir=${0%/*}
[ "$dir" = "$0" ] && dir=.

php=$(command -v php 2>/dev/null)

if [ -z "$php" ]; then
    printf '%s\n' "pre-commit: WARNING — no php on PATH, so the test-lane check could not run. Allowing the commit." >&2
    exit 0
fi

exec "$php" "$dir/pre-commit-lane-guard.php"
