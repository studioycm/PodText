{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "awcodes/filament-curator": "^5.1",
        "bezhansalleh/filament-shield": "^4.3",
        "filament/filament": "~5.0",
        "filament/spatie-laravel-settings-plugin": "^5.6",
        "filament/spatie-laravel-tags-plugin": "^5.6",
        "google/apiclient": "^2.0",
        "laravel/framework": "^13.8",
        "laravel/horizon": "^5.47",
        "laravel/socialite": "^5.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.3",
        "resend/resend-laravel": "^1.4",
        "spatie/laravel-permission": "^8.0",
        "spatie/laravel-settings": "^3.9",
        "spatie/laravel-tags": "^4.12"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "fakerphp/faker": "^1.23",
        "filament/blueprint": "^2.2",
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.5",
        "laravel/doctor": "0.1.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laraveldaily/filacheck": "^1.2",
        "laraveldaily/filacheck-pro": "^1.2",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-drift": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "boost:sync": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan boost:install --guidelines --skills --mcp --no-interaction",
            "@php artisan test --compact --filter=FilacheckAgentModeGuard"
        ],
        "boost:refresh": [
            "@php artisan boost:update --no-discover --no-interaction",
            "@boost:sync"
        ],
        "filacheck": [
            "@putenv FILACHECK_DISABLE_AGENT_MODE=1",
            "vendor/bin/filacheck"
        ],
        "filacheck:fix": [
            "@putenv FILACHECK_DISABLE_AGENT_MODE=1",
            "vendor/bin/filacheck --fix"
        ],
        "types:check": [
            "@php -d memory_limit=2G vendor/bin/phpstan analyse --no-progress"
        ],
        "rector": [
            "vendor/bin/rector process --dry-run --ansi"
        ],
        "rector:fix": [
            "vendor/bin/rector process --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "filament",
            "type": "composer",
            "url": "https://packages.filamentphp.com/composer"
        },
        {
            "name": "filacheck",
            "type": "composer",
            "url": "https://satis.filamentexamples.com"
        }
    ]
}
